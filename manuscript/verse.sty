%%
%% Minimal `verse.sty' compatibility shim.
%% The MDPI class (lines 87-89) only needs the verse counters referenced by
%% \theHpoemline and the standard kernel verse environment. The current CTAN
%% `verse' requires a newer kernel (\IfDocumentMetadataTF, 2022+), which is
%% unavailable on this TeX Live, so provide the minimal definitions here.
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{verse}[2026/10/27 minimal verse compatibility shim]
\newcounter{verse@envctr}
\newcounter{poemline}
\providecommand{\theHpoemline}{\arabic{verse@envctr}.\arabic{poemline}}
% The kernel already defines the standard `verse` environment; keep it.
% Robust no-op for the newer package's title command (unused in this paper).
\providecommand{\poemtitle}[2][]{#2}
\endinput
